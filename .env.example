# Copie este archivo como .env y reemplace el valor de ejemplo.
GOOGLE_MAPS_API_KEY=pegue_aqui_su_api_key

# Cambie a true solamente cuando quiera ejecutar consultas facturables.
EJECUTAR_GOOGLE_MAPS=false

# Solo se consultan paradas cuyo tiempo GTFS no supera este umbral.
UMBRAL_ANALISIS_MIN=30

# Minutos estimados de espera/caminata cada vez que cambia la ruta.
PENALIZACION_TRANSBORDO_MIN=5
